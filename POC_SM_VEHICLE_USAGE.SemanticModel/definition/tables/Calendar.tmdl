/// Schema-qualified POC_reporting.POC_calendar; one validated publication.
table Calendar

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-MM-dd
		dataCategory: Time
		summarizeBy: none
		sourceColumn: date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column Month
		dataType: int64
		summarizeBy: none
		sourceColumn: month

	partition Calendar = entity
		mode: directLake
		source
			entityName: poc_calendar
			schemaName: POC_reporting
			expressionSource: 'Direct Lake BRP2'

